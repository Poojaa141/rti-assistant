GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Optional: Supabase for cloud database
# If missing, app uses local SQLite automatically
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Comma-separated frontend URLs allowed to call the backend.
FRONTEND_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app
